# Application
APP_NAME=Quiz App
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quiz_app
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# MinIO / S3
MINIO_URL=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=flashcards
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_SECURE=False

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=500

# Google Cloud Text-to-Speech
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/google-credentials.json
TTS_LANGUAGE_CODE=en-US
TTS_VOICE_NAME=en-US-Neural2-F

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/wav,audio/ogg

# Celery
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Email (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@quizapp.com
SMTP_FROM_NAME=Quiz App

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log

# Spaced Repetition
DEFAULT_EASE_FACTOR=2.5
MIN_EASE_FACTOR=1.3
MAX_EASE_FACTOR=2.5

# Achievements
ENABLE_ACHIEVEMENTS=True
CHECK_ACHIEVEMENTS_INTERVAL_SECONDS=300

# Testing
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quiz_app_test
